# ==============================================================================
# Multi-Tenant RAG System Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Demo Company Passwords for Graders / Reviewers
# (Hashed with bcrypt in tenants.yaml; plaintext values below)
# ------------------------------------------------------------------------------
# Tenant 'acme' (Acme Corp):
#   ID: acme
#   Password: AcmeSecret2026!
#
# Tenant 'globex' (Globex Corporation):
#   ID: globex
#   Password: GlobexSecret2026!
# ------------------------------------------------------------------------------

# LLM Provider Configuration
# Supported providers: gemini (default), groq, claude
LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Selection (Overrides default model per provider if specified)
# gemini default: gemini-3.6-flash
# groq default: llama-3.3-70b-versatile
# claude default: claude-3-5-haiku-20241022
LLM_MODEL=
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Vector Database Storage (Isolated directories/collections per tenant)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Application Settings
API_HOST=0.0.0.0
API_PORT=8000
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Google Sign-In OAuth 2.0 Client ID (Required for Google identity token validation)
GOOGLE_CLIENT_ID=329878057926-7b1n7jk22m4hd2ergntsrt2rda79k0f5.apps.googleusercontent.com

# Rate Limiting Configuration (slowapi + persistent SQLite backend)
# Keyed by Google identity (google_sub claim) across all tenants
# Format: '<queries>/day;<queries>/7 days' or '<queries>/minute'
RATE_LIMIT_QUERY=50/day;200/7 days
RATE_LIMIT_STORAGE_URI=sqlite:///data/rate_limits.db
RATE_LIMIT_ENABLED=true

# Security & JWT Tokens
JWT_SECRET_KEY=multi-tenant-rag-super-secure-jwt-signing-key-32chars!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
